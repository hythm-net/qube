# Managed by Ansible (hosts/chthon); values come from Bitwarden at apply time.
BACKPACK_ENDPOINT={{ backpack_secret.endpoint | regex_replace('^https://', '') }}
BACKPACK_BUCKET={{ backpack_secret.bucket }}
AWS_ACCESS_KEY_ID={{ backpack_secret.access_key_id }}
AWS_SECRET_ACCESS_KEY={{ backpack_secret.secret_access_key }}
FILES_KOPIA_PASSWORD={{ backpack_secret.files_repository_password }}
VOLSYNC_KOPIA_PASSWORD={{ volsync_secret.KOPIA_PASSWORD }}
BACKPACK_HEALTHCHECK_URL={{ backpack_secret.healthcheck_url }}
BACKPACK_SOURCES="{{ backpack.sources | join(' ') }}"
BACKPACK_KEEP_LATEST={{ backpack.keep.latest }}
BACKPACK_KEEP_DAILY={{ backpack.keep.daily }}
BACKPACK_KEEP_WEEKLY={{ backpack.keep.weekly }}
BACKPACK_KEEP_MONTHLY={{ backpack.keep.monthly }}
