[Unit]
Description=backpack: off-site copy of chthon's irreplaceable data to R2
Wants=network-online.target
After=network-online.target nfs-server.service

[Service]
Type=oneshot
EnvironmentFile=/etc/backpack/env
# kopia needs a home for its config, cache and logs; systemd creates these
StateDirectory=backpack
CacheDirectory=backpack
LogsDirectory=backpack
# each repository gets its own cache under /var/cache/backpack (backpack.sh); a shared one
# mixes up their format blobs
Environment=HOME=/var/lib/backpack KOPIA_LOG_DIR=/var/log/backpack
ExecStart=/usr/local/libexec/backpack
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=6h
