{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Auto-merge app containers and charts: digests, patches and minors. A broken rollout is rolled back by Flux (RemediateOnFailure) and the next release merges the same way.",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest", "patch", "minor"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Hold 0.x minors for review: zer0ver minors can break at any time",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "/^v?0\\./",
      automerge: false,
    },
    {
      description: "Hold minors whose upgrades migrate data a rollback cannot undo",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor"],
      matchPackageNames: ["/immich-app/", "/jellyfin/", "/paperless-ngx/", "/pocket-id/"],
      automerge: false,
    },
    {
      description: "Keep the platform manual: node OS, Kubernetes, Flux, networking, DNS, certificates, secrets, storage, databases, GPU and CI",
      matchPackageNames: [
        "/siderolabs/",
        "/talos/",
        "/registry.k8s.io/kube-/",
        "/controlplaneio-fluxcd/",
        "/cilium/",
        "/multus/",
        "/coredns/",
        "/k8s-gateway/",
        "/external-dns/",
        "/envoyproxy/",
        "/crowdsec/",
        "/envoy-proxy-bouncer/",
        "/cert-manager/",
        "/external-secrets/",
        "/openebs/",
        "/volsync/",
        "/snapshot-controller/",
        "/cloudnative-pg/",
        "/k8s-gpu-dra-driver/",
        "/tuppr/",
        "/descheduler/",
        "/actions-runner-controller/",
      ],
      automerge: false,
    },
    {
      description: "Auto-merge high-cadence OCI packages weekly",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/kube-prometheus-stack/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      schedule: ["before 6am on Monday"],
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "3 days",
      ignoreTests: false,
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: ["/^actions\\//", "/^renovatebot\\//"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "1 minute",
      ignoreTests: false,
    },
    {
      description: "Auto-merge Grafana dashboards",
      matchDatasources: ["custom.grafana-dashboards"],
      matchUpdateTypes: ["major"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge Renovate Presents",
      matchManagers: ["renovate-config"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
  ],
}
